# ─────────────────────────────────────────────────────────────────────────────
# ForumX Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env — it is git-ignored.
# For Azure App Service, configure these in:
#   Azure Portal → App Service → Configuration → Application settings
# ─────────────────────────────────────────────────────────────────────────────

# ── Spring Profile ────────────────────────────────────────────────────────────
# Use "dev" profile locally (disables Redis, RabbitMQ, uses in-memory fallbacks)
# Use no profile (or "prod") in production
spring.profiles.active=dev

# ── Database (Neon PostgreSQL or any PostgreSQL instance) ─────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/forumx
SPRING_DATASOURCE_USERNAME=forumx
SPRING_DATASOURCE_PASSWORD=changeme

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
APP_SECURITY_JWT_SECRET=change-me-to-a-base64-encoded-256-bit-secret-key

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
SPRING_MAIL_USERNAME=${GMAIL_ADDRESS}
SPRING_MAIL_PASSWORD=${GMAIL_APP_PASSWORD}

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL of the deployed frontend — used in email verification / password reset links
APP_FRONTEND_BASE_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Local dev: http://localhost:3000
# Production: https://your-app.azurestaticapps.net
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── WebSocket Allowed Origins ─────────────────────────────────────────────────
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000

# ── Redis (Upstash or local Redis) ───────────────────────────────────────────
# Leave empty for local dev (Redis is disabled in the "dev" profile)
FORUMX_REDIS_HOST=localhost
FORUMX_REDIS_PASSWORD=

# ── RabbitMQ (CloudAMQP or local RabbitMQ) ───────────────────────────────────
# Leave empty for local dev (messaging is disabled in the "dev" profile)
FORUMX_MESSAGING_HOST=localhost
FORUMX_MESSAGING_VHOST=/
FORUMX_MESSAGING_USERNAME=guest
FORUMX_MESSAGING_PASSWORD=guest

# ── Bootstrap (Platform Admin) ────────────────────────────────────────────────
# Initial platform admin account created on first startup
FORUMX_BOOTSTRAP_PLATFORM_ADMIN=true
FORUMX_BOOTSTRAP_PLATFORM_ADMIN_EMAIL=platform-admin@forumx.local
FORUMX_BOOTSTRAP_PLATFORM_ADMIN_USERNAME=platform_admin
FORUMX_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=AdminPassword123!
